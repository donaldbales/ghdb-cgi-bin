drop   table ghdb;
create table ghdb (
plant_name                     varchar(30)  not null  primary key,
latin_name                     varchar(30),
height                         decimal(5,2),
width                          decimal(5,2),
planting_depth                 decimal(5,2),
seed_size                      decimal(5,2),
seed_need_light                varchar(3)  check (seed_need_light in (NULL, 'no', 'yes')),
seed_scarification             varchar(3)  check (seed_scarification in (NULL, 'no', 'yes')),
ph                             decimal(5,2),
ec                             decimal(5,2),
day_light_interval             decimal(5,0),
photoperiod_hours              decimal(5,0),
light_lower                    decimal(5,0),
light_optimal                  decimal(5,0),
light_upper                    decimal(5,0),
nitrogen_lower                 decimal(5,0),
nitrogen_optimal               decimal(5,0),
nitrogen_upper                 decimal(5,0),
phosphorus_lower               decimal(5,0),
phosphorus_optimal             decimal(5,0),
phosphorus_upper               decimal(5,0),
potassium_lower                decimal(5,0),
potassium_optimal              decimal(5,0),
potassium_upper                decimal(5,0),
germination_lower              decimal(5,0),
germination_normal             decimal(5,0),
germination_upper              decimal(5,0),
transplanting_lower            decimal(5,0),
transplanting_optimal          decimal(5,0),
transplanting_upper            decimal(5,0),
maturity_lower                 decimal(5,0),
maturity_optimal               decimal(5,0),
maturity_upper                 decimal(5,0),
frost_tolerance                varchar(3)  check (frost_tolerance in (NULL, 'no', 'yes')),
flowering                      decimal(5,0),
pollination_primary            varchar(30),
pollination_secondary          varchar(30) );
